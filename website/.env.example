# Canonical GitHub Pages deployment root. Replace only when an owner-approved
# custom domain becomes the public authority.
SITE_URL=https://iunknown404i.github.io/threadcells

# GitHub Pages repository subpath. Leave unset for root-path local development.
NEXT_PUBLIC_BASE_PATH=/threadcells

# Optional reconciliation source; defaults to the repository containing website/.
THREADCELLS_PRODUCT_ROOT=

# Google Search Console verification is owner-provided. Set this to the exact
# content token issued by Search Console; it emits the standard verification meta tag.
GOOGLE_SITE_VERIFICATION=
# Optional exact filename issued for Search Console's HTML-file verification.
# It writes `google-site-verification: <filename>` into website/out at build time.
GOOGLE_SITE_VERIFICATION_FILE=
