[Unit]
Description=ThreadCells privileged Full Cleanup helper connection

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/srv/agent-control
Environment=HOME=/home/agentctl
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/var/lib/threadcells/active/runtime/bin:/srv/agent-control/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/agent-control/cao.env
ExecStart=/var/lib/threadcells/active/runtime/bin/threadcells-full-cleanup-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
# The one-shot must enter and leave the runtime account around trusted state
# reads.  Keep that set*id transition available while bounding root to the
# exact filesystem, signal, and identity capabilities used by the executor.
NoNewPrivileges=false
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_KILL CAP_SETGID CAP_SETUID
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
UMask=0077
