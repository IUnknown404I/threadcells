[Unit]
Description=ThreadCells weekly reference-aware maintenance
After=agent-control-cao.service

[Service]
Type=oneshot
User=agentctl
Group=agentctl
SupplementaryGroups=docker threadcells-release-admin
Environment=HOME=/home/agentctl
Environment=PATH=/var/lib/threadcells/active/runtime/bin:/srv/agent-control/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/var/lib/threadcells/active/runtime/bin/cao-housekeeping --mode weekly --scheduled
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
UMask=0077
